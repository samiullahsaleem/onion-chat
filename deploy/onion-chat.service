[Unit]
Description=onion-chat relay
After=network.target

[Service]
ExecStart=/usr/local/bin/onion-chat -addr 127.0.0.1:8080
DynamicUser=yes
Restart=on-failure
# Nothing to log; keep stdout/stderr out of the journal.
StandardOutput=null
StandardError=null

# Sandbox: the binary needs no files, no privileges and only loopback networking.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=256M

[Install]
WantedBy=multi-user.target
